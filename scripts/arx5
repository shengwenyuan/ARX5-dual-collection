#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
STATION_DIR = Path("/var/lib/arx5-collection")
DATASET_IMAGE = "arx5-dual-collection:dataset"


def required(name: str) -> str:
    value = os.environ.get(name)
    if not value:
        raise ValueError(f"set {name}")
    return value


def collect(rgb_only: bool = False) -> int:
    required("ARX5_OUTPUT_ROOT")
    required("ARX5_TASK_DESCRIPTION")
    environment = os.environ.copy()
    environment.pop("ARX5_TASK_CONFIG", None)
    if rgb_only:
        environment["ARX5_TASK_CONFIG"] = "/workspace/config/task.rgb-only.json"
    return subprocess.call(
        [
            "docker",
            "compose",
            "-f",
            str(ROOT / "docker/compose.production.yaml"),
            "run",
            "--rm",
            "collector",
        ],
        cwd=ROOT,
        env=environment,
    )


def dagger(mode: str) -> int:
    required("ARX5_OUTPUT_ROOT")
    required("ARX5_TASK_DESCRIPTION")
    environment = {**os.environ, "ARX5_DAGGER_MODE": mode}
    return subprocess.call(
        [
            "docker",
            "compose",
            "--env-file",
            str(STATION_DIR / "dagger.env"),
            "-f",
            str(ROOT / "docker/compose.dagger.yaml"),
            "up",
            "--no-build",
            "--abort-on-container-exit",
            "--exit-code-from",
            "collector",
            "collector",
        ],
        cwd=ROOT,
        env=environment,
    )


def upload(full_check: str) -> int:
    source = required("ARX5_OUTPUT_ROOT")
    task = required("ARX5_TASK_DESCRIPTION")
    temporary = Path.home() / "swy/bos-upload-tmp"
    temporary.mkdir(parents=True, exist_ok=True)
    interactive = ["-i", "-t"] if sys.stdin.isatty() else ["-i"]
    return subprocess.call(
        [
            "docker",
            "run",
            "--rm",
            *interactive,
            "--name",
            "arx5-bos-upload",
            "-v",
            f"{ROOT}:/workspace:ro",
            "-v",
            f"{source}:{source}",
            "-v",
            f"{STATION_DIR}:{STATION_DIR}:ro",
            "-v",
            "/usr/local/bin/bcecmd:/usr/local/bin/bcecmd:ro",
            "-v",
            f"{Path.home() / '.go-bcecli'}:/root/.go-bcecli",
            "-v",
            f"{temporary}:/tmp",
            DATASET_IMAGE,
            "python3",
            "/workspace/tools/bos_upload_episodes.py",
            "--source",
            source,
            "--task-description",
            task,
            "--full-check",
            full_check,
        ]
    )


def main() -> int:
    parser = argparse.ArgumentParser(prog="arx5")
    commands = parser.add_subparsers(dest="command", required=True)
    collect_parser = commands.add_parser(
        "collect", help="start a production collection Session"
    )
    collect_parser.add_argument(
        "--rgb-only",
        action="store_true",
        help="temporarily omit aligned depth from the recorded MCAP",
    )
    dagger_parser = commands.add_parser("dagger", help="start a DAgger Session")
    dagger_parser.add_argument(
        "--mode", choices=("takeover", "shadow"), default="takeover"
    )
    upload_parser = commands.add_parser(
        "upload", help="validate and upload the Session"
    )
    upload_parser.add_argument(
        "--full-check", choices=("true", "false"), default="true"
    )
    args = parser.parse_args()
    try:
        if args.command == "collect":
            return collect(args.rgb_only)
        if args.command == "dagger":
            return dagger(args.mode)
        return upload(args.full_check)
    except ValueError as error:
        parser.error(str(error))


if __name__ == "__main__":
    raise SystemExit(main())
