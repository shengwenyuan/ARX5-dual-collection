#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
STATION_DIR = Path(os.environ.get("ARX5_STATION_DIR", "/var/lib/arx5-collection"))
DATASET_IMAGE = os.environ.get("ARX5_DATASET_IMAGE", "arx5-dual-collection:dataset")
DEFAULT_COLLECTION_CONFIG = ROOT / "config/collection/fold-cloth-rgbd.toml"


def required(name: str) -> str:
    value = os.environ.get(name)
    if not value:
        raise ValueError(f"set {name}")
    return value


def collection_config(path: Path | None = None) -> Path:
    configured = os.environ.get("ARX5_COLLECTION_CONFIG")
    if path is not None:
        result = path
    elif configured:
        result = Path(configured)
    else:
        result = DEFAULT_COLLECTION_CONFIG
    result = result.resolve()
    if not result.is_file():
        raise ValueError(f"collection config does not exist: {result}")
    return result


def collect(config: Path | None = None) -> int:
    required("ARX5_OUTPUT_ROOT")
    environment = os.environ.copy()
    environment["ARX5_COLLECTION_CONFIG"] = str(collection_config(config))
    return subprocess.call(
        [
            "docker",
            "compose",
            "-f",
            str(ROOT / "config/runner/compose.production.yaml"),
            "run",
            "--rm",
            "collector",
        ],
        cwd=ROOT,
        env=environment,
    )


def dagger(mode: str, config: Path | None = None) -> int:
    environment = {**os.environ, "ARX5_DAGGER_MODE": mode}
    if config is not None:
        environment["ARX5_COLLECTION_CONFIG"] = str(collection_config(config))
    return subprocess.call(
        [
            "docker",
            "compose",
            "--env-file",
            str(STATION_DIR / "dagger.env"),
            "-f",
            str(ROOT / "config/runner/compose.dagger.yaml"),
            "up",
            "--no-build",
            "--abort-on-container-exit",
            "--exit-code-from",
            "collector",
            "collector",
        ],
        cwd=ROOT,
        env=environment,
    )


def upload(full_check: str, config: Path | None = None) -> int:
    source = required("ARX5_OUTPUT_ROOT")
    config_path = collection_config(config)
    temporary = Path(
        os.environ.get("ARX5_UPLOAD_TMP_ROOT", Path.home() / "swy/bos-upload-tmp")
    )
    temporary.mkdir(parents=True, exist_ok=True)
    interactive = ["-i", "-t"] if sys.stdin.isatty() else ["-i"]
    return subprocess.call(
        [
            "docker",
            "run",
            "--rm",
            *interactive,
            "--name",
            "arx5-bos-upload",
            "-v",
            f"{ROOT}:/workspace:ro",
            "-v",
            f"{source}:{source}",
            "-v",
            f"{config_path}:/config/collection.toml:ro",
            "-v",
            f"{STATION_DIR}:{STATION_DIR}:ro",
            "-v",
            "/usr/local/bin/bcecmd:/usr/local/bin/bcecmd:ro",
            "-v",
            f"{Path.home() / '.go-bcecli'}:/root/.go-bcecli",
            "-v",
            f"{temporary}:/tmp",
            "-e",
            "ARX5_CONFIG_ROOT=/workspace/config",
            "-e",
            "ARX5_ENVIRONMENT_CONFIG=/workspace/config/environment/default.toml",
            DATASET_IMAGE,
            "python3",
            "/workspace/scripts/adapters/bos_upload_episodes.py",
            "--source",
            source,
            "--collection-config",
            "/config/collection.toml",
            "--full-check",
            full_check,
        ]
    )


def main() -> int:
    parser = argparse.ArgumentParser(prog="arx5")
    commands = parser.add_subparsers(dest="command", required=True)
    collect_parser = commands.add_parser(
        "collect", help="start a production collection Session"
    )
    collect_parser.add_argument(
        "--collection-config",
        type=Path,
    )
    dagger_parser = commands.add_parser("dagger", help="start a DAgger Session")
    dagger_parser.add_argument(
        "--mode", choices=("takeover", "shadow"), default="takeover"
    )
    dagger_parser.add_argument(
        "--collection-config",
        type=Path,
    )
    upload_parser = commands.add_parser(
        "upload", help="validate and upload the Session"
    )
    upload_parser.add_argument(
        "--full-check", choices=("true", "false"), default="true"
    )
    upload_parser.add_argument(
        "--collection-config",
        type=Path,
    )
    args = parser.parse_args()
    try:
        if args.command == "collect":
            return collect(args.collection_config)
        if args.command == "dagger":
            return dagger(args.mode, args.collection_config)
        return upload(args.full_check, args.collection_config)
    except ValueError as error:
        parser.error(str(error))


if __name__ == "__main__":
    raise SystemExit(main())
