FROM arx5-dual-collection:dataset

ARG OPENPI_COMMIT=15a9616a00943ada6c20a0f158e3adb39df2ccac

RUN GIT_LFS_SKIP_SMUDGE=1 git clone --filter=blob:none https://github.com/Physical-Intelligence/openpi.git /opt/openpi \
    && git -C /opt/openpi checkout "${OPENPI_COMMIT}" \
    && test "$(git -C /opt/openpi rev-parse HEAD)" = "${OPENPI_COMMIT}"

# Validation is intentionally CPU-only. The official openpi lock selects
# jax[cuda12]; CUDA training belongs in the separate RPBZZZ6 environment.
RUN /opt/dataset-venv/bin/python -m pip install --no-cache-dir \
        augmax==0.3.4 \
        beartype==0.19.0 \
        chex==0.1.90 \
        dm-tree==0.1.9 \
        einops==0.8.1 \
        equinox==0.11.12 \
        etils==1.13.0 \
        flatbuffers==25.2.10 \
        flax==0.10.2 \
        "fsspec[gcs]==2025.3.0" \
        jax==0.5.3 \
        jaxlib==0.5.3 \
        jaxtyping==0.2.36 \
        ml-dtypes==0.4.1 \
        ml_collections==1.0.0 \
        numpydantic==1.6.10 \
        numpy==1.26.4 \
        opencv-python-headless==4.11.0.86 \
        optax==0.2.4 \
        orbax-checkpoint==0.11.13 \
        polars==1.31.0 \
        protobuf==4.25.8 \
        pydantic==2.11.5 \
        rich==14.0.0 \
        scipy==1.15.3 \
        sentencepiece==0.2.0 \
        tensorstore==0.1.74 \
        tqdm-loggable==0.2 \
        transformers==4.53.2 \
        treescope==0.1.9 \
        tyro==0.9.24 \
        wandb==0.19.11

COPY src /opt/arx5-dataset/src

ENV JAX_PLATFORMS=cpu
ENV PYTHONPATH="/opt/openpi/src:/opt/openpi/packages/openpi-client/src:${PYTHONPATH}"

RUN python -c "import jax, openpi; assert jax.default_backend() == 'cpu'"
