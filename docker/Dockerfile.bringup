ARG ROS_DISTRO=jazzy
FROM ros:${ROS_DISTRO}-ros-base-noble AS sdk-builder

ARG ROS_DISTRO
ARG ARX_X5_REF=main
ARG LIBREALSENSE_REF=v2.54.2

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY docker/patches/librealsense-v2.54.2-gcc13-cstdint.patch /tmp/
COPY docker/patches/arx-x5-go-home-services.patch /tmp/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        libssl-dev \
        libudev-dev \
        libusb-1.0-0-dev \
        ninja-build \
        patch \
        pkg-config \
        python3-colcon-common-extensions \
        python3-dev \
        python3-pip \
        ros-${ROS_DISTRO}-ament-index-cpp \
        ros-${ROS_DISTRO}-launch-ros \
        ros-${ROS_DISTRO}-std-srvs \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/vendor/librealsense \
    && curl --fail --location --retry 3 --retry-all-errors \
        "https://github.com/realsenseai/librealsense/archive/refs/tags/${LIBREALSENSE_REF}.tar.gz" \
        --output /tmp/librealsense.tar.gz \
    && tar --extract --gzip --file /tmp/librealsense.tar.gz \
        --directory /opt/vendor/librealsense --strip-components=1 \
    && rm /tmp/librealsense.tar.gz \
    && patch --directory /opt/vendor/librealsense --strip 1 \
        < /tmp/librealsense-v2.54.2-gcc13-cstdint.patch \
    && cmake -S /opt/vendor/librealsense -B /opt/vendor/librealsense/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_GRAPHICAL_EXAMPLES=OFF \
        -DBUILD_PYTHON_BINDINGS=ON \
        -DBUILD_TOOLS=ON \
        -DFORCE_RSUSB_BACKEND=ON \
        -DPYTHON_EXECUTABLE=/usr/bin/python3 \
    && cmake --build /opt/vendor/librealsense/build --parallel \
    && cmake --install /opt/vendor/librealsense/build

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && git -c http.version=HTTP/1.1 clone \
        --depth 1 --filter=blob:none --sparse --branch "${ARX_X5_REF}" \
        https://github.com/ARXroboticsX/ARX_X5.git /opt/vendor/ARX_X5 \
    && git -C /opt/vendor/ARX_X5 sparse-checkout set ROS2/X5_ws/src \
    && patch --directory /opt/vendor/ARX_X5 --strip 1 \
        < /tmp/arx-x5-go-home-services.patch \
    && mkdir -p /opt/arx_ws/src \
    && cp -a /opt/vendor/ARX_X5/ROS2/X5_ws/src/. /opt/arx_ws/src/ \
    && source "/opt/ros/${ROS_DISTRO}/setup.bash" \
    && cd /opt/arx_ws \
    && colcon build --merge-install --cmake-args -DCMAKE_BUILD_TYPE=Release

COPY ros2_ws/src/ /opt/collection_ws/src/

RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" \
    && source /opt/arx_ws/install/setup.bash \
    && cd /opt/collection_ws \
    && colcon build --merge-install

FROM ros:${ROS_DISTRO}-ros-base-noble AS runtime-hardware

ARG ROS_DISTRO
ARG ARX_X5_REF=main
ARG LIBREALSENSE_REF=v2.54.2

LABEL org.opencontainers.image.source="https://github.com/ARXroboticsX/ARX_X5" \
      arx5.sdk.ref="${ARX_X5_REF}" \
      realsense.sdk.ref="${LIBREALSENSE_REF}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        can-utils \
        iproute2 \
        libusb-1.0-0 \
        python3 \
        python3-pip \
        ros-${ROS_DISTRO}-rosbag2 \
        ros-${ROS_DISTRO}-rosbag2-storage-mcap \
        ros-${ROS_DISTRO}-std-srvs \
        udev \
        usbutils \
        v4l-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=sdk-builder /usr/local/ /usr/local/
COPY --from=sdk-builder /opt/arx_ws/install/ /opt/arx_ws/install/
COPY --from=sdk-builder /opt/collection_ws/install/ /opt/collection_ws/install/

ENV AMENT_PREFIX_PATH="/opt/collection_ws/install:/opt/arx_ws/install" \
    CMAKE_PREFIX_PATH="/opt/collection_ws/install:/opt/arx_ws/install" \
    LD_LIBRARY_PATH="/usr/local/lib:/opt/collection_ws/install/lib:/opt/arx_ws/install/lib" \
    PATH="/opt/collection_ws/install/bin:/opt/arx_ws/install/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    PYTHONPATH="/opt/collection_ws/install/lib/python3.12/site-packages:/opt/arx_ws/install/lib/python3.12/site-packages:/opt/arx5-runtime/src:/usr/local/OFF" \
    RMW_IMPLEMENTATION="rmw_fastrtps_cpp" \
    FASTDDS_DEFAULT_PROFILES_FILE="/opt/arx5-dual-collection/config/fastdds-shm.xml"

WORKDIR /workspace

FROM runtime-hardware AS runtime-base

COPY src/ /opt/arx5-runtime/src/
COPY pyproject.toml /opt/arx5-runtime/pyproject.toml
COPY config/fastdds-shm.xml /opt/arx5-dual-collection/config/fastdds-shm.xml
COPY scripts/ /opt/arx5-dual-collection/scripts/

RUN python3 -m pip install \
        --break-system-packages \
        --no-build-isolation \
        --no-deps \
        /opt/arx5-runtime

FROM runtime-base AS bringup
ENTRYPOINT ["/opt/arx5-dual-collection/scripts/can_daemon.sh"]

FROM runtime-base AS production
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["arx5-collect", "--help"]

FROM ros:${ROS_DISTRO}-ros-base-noble AS dagger-python-builder

ARG OPENPI_COMMIT=15a9616a00943ada6c20a0f158e3adb39df2ccac

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /tmp/openpi-client \
    && curl --fail --location --retry 3 --retry-all-errors \
        "https://github.com/Physical-Intelligence/openpi/archive/${OPENPI_COMMIT}.tar.gz" \
        --output /tmp/openpi.tar.gz \
    && tar --extract --gzip --file /tmp/openpi.tar.gz \
        --directory /tmp/openpi-client \
        --strip-components=3 \
        "openpi-${OPENPI_COMMIT}/packages/openpi-client" \
    && python3 -m pip wheel \
        --wheel-dir /tmp/dagger-wheels \
        /tmp/openpi-client \
        opencv-python-headless==4.11.0.86

FROM runtime-hardware AS dagger-collector

COPY --from=dagger-python-builder /tmp/dagger-wheels /tmp/dagger-wheels

RUN python3 -m pip install \
        --break-system-packages \
        --no-index \
        --find-links /tmp/dagger-wheels \
        openpi-client \
        opencv-python-headless==4.11.0.86 \
    && rm -rf /tmp/dagger-wheels

COPY src/ /opt/arx5-runtime/src/
COPY pyproject.toml /opt/arx5-runtime/pyproject.toml
COPY config/fastdds-shm.xml /opt/arx5-dual-collection/config/fastdds-shm.xml
COPY scripts/ /opt/arx5-dual-collection/scripts/

RUN python3 -m pip install \
        --break-system-packages \
        --no-build-isolation \
        --no-deps \
        /opt/arx5-runtime

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["arx5-collect", "--help"]
