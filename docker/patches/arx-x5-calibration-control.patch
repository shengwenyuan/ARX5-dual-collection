+void X5Controller::freezeCalibration() {
+  manual_takeover_.store(true);
+  const auto actual = interfaces_ptr_->getJointPositons();
+  calibration_target_.clear();
+  if (actual.size() < 6 || !std::all_of(actual.begin(), actual.begin() + 6,
+                                      [](double x) { return std::isfinite(x); })) return;
+  calibration_target_.assign(actual.begin(), actual.begin() + 6);
+  interfaces_ptr_->setJointPositions(calibration_target_);
+  interfaces_ptr_->setArmStatus(InterfacesThread::state::POSITION_CONTROL);
+  // Preserve SDK gripper target/torque; never turn measured position into a new grasp command.
+}
+
+void X5Controller::calibrationHold(
+    const std::shared_ptr<std_srvs::srv::Trigger::Request>,
+    std::shared_ptr<std_srvs::srv::Trigger::Response> response) {
+  freezeCalibration();
+  response->success = calibration_target_.size() == 6;
+  response->message = "calibration commands latched off; position hold requested";
+}
+
+void X5Controller::calibrationCommand(const arx5_arm_msg::msg::RobotStatus & message) {
+  const auto now = std::chrono::steady_clock::now();
+  const double dt = std::chrono::duration<double>(now - calibration_last_command_).count();
+  const double source_age = (this->get_clock()->now() - rclcpp::Time(message.header.stamp)).seconds();
+  const double allowed_step = 0.20 * std::min(dt, 0.10) + 0.001;
+  if (calibration_target_.size() != 6 || dt > 0.25 || source_age < -0.02 || source_age > 0.10) {
+    freezeCalibration();
+    return;
+  }
+  for (int i = 0; i < 6; ++i) {
+    if (!std::isfinite(message.joint_pos[i]) ||
+        std::abs(message.joint_pos[i] - calibration_target_[i]) > allowed_step) {
+      freezeCalibration();
+      return;
+    }
+  }
+  calibration_target_.assign(message.joint_pos.begin(), message.joint_pos.begin() + 6);
+  calibration_last_command_ = now;
+  interfaces_ptr_->setJointPositions(calibration_target_);
+  interfaces_ptr_->setArmStatus(InterfacesThread::state::POSITION_CONTROL);
+}
