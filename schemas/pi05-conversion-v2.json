{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arx5.local/schemas/pi05-conversion-v2.json",
  "title": "ARX5 equal-EEF-distance π0.5 LeRobot conversion report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo_id", "openpi_commit", "lerobot_commit", "fps", "mode",
    "image_size", "image_color", "source_selection_dir", "output_root",
    "episode_count", "frame_count", "state_action_order",
    "state_action_version", "filter_version", "sampling_contract",
    "gripper_calibration", "tasks"
  ],
  "properties": {
    "repo_id": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "openpi_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "lerobot_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "fps": { "const": 50 },
    "mode": { "enum": ["video", "image"] },
    "image_size": { "const": [640, 360] },
    "image_color": { "const": "RGB" },
    "source_selection_dir": { "type": "string" },
    "output_root": { "type": "string" },
    "episode_count": { "type": "integer", "minimum": 1 },
    "frame_count": { "type": "integer", "minimum": 1 },
    "state_action_order": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "type": "string" }
    },
    "state_action_version": { "const": "arx5-measured-position-proxy-v1" },
    "filter_version": { "const": "pi05-arx-filter-v2-equal-eef-distance" },
    "sampling_contract": { "$ref": "#/$defs/samplingContract" },
    "gripper_calibration": {
      "type": "object",
      "required": ["left", "right"],
      "additionalProperties": false,
      "properties": {
        "left": { "$ref": "#/$defs/gripperCalibration" },
        "right": { "$ref": "#/$defs/gripperCalibration" }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "gripperCalibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_value", "closed_value", "tolerance"],
      "properties": {
        "open_value": { "type": "number" },
        "closed_value": { "type": "number" },
        "tolerance": { "type": "number", "minimum": 0 }
      }
    },
    "samplingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "eef_field", "translation_unit", "distance_metric",
        "dual_arm_reduce", "eef_distance_m", "gripper_delta_threshold",
        "max_sample_interval_ns", "timestamp_clock", "observation_rule",
        "nominal_fps", "horizon_semantics"
      ],
      "properties": {
        "mode": { "const": "equal_eef_distance" },
        "eef_field": { "const": "ArmState.eef_xyzrpy[:3]" },
        "translation_unit": { "const": "metre" },
        "distance_metric": { "const": "endpoint_euclidean" },
        "dual_arm_reduce": { "const": "max" },
        "eef_distance_m": { "type": "number", "exclusiveMinimum": 0 },
        "gripper_delta_threshold": { "type": "number", "exclusiveMinimum": 0 },
        "max_sample_interval_ns": { "type": "integer", "exclusiveMinimum": 0 },
        "timestamp_clock": { "const": "header_stamp_ns" },
        "observation_rule": { "const": "latest_complete_frame_group_at_or_before_tick" },
        "nominal_fps": { "const": 50 },
        "horizon_semantics": { "const": "trajectory_steps" }
      }
    }
  }
}
