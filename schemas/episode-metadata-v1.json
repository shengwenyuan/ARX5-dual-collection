{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARX5 Episode Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "task",
    "outcome",
    "timing",
    "station",
    "streams",
    "calibration",
    "software",
    "errors",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "collection_type": {"enum": ["demonstration", "dagger", "infer"]},
    "dagger": {"$ref": "#/$defs/dagger"},
    "episode_id": {"type": "string", "minLength": 1},
    "task": {"$ref": "#/$defs/task"},
    "outcome": {"enum": ["success", "fail", "aborted"]},
    "timing": {"$ref": "#/$defs/timing"},
    "station": {"$ref": "#/$defs/station"},
    "streams": {
      "type": "array",
      "items": {"$ref": "#/$defs/stream"}
    },
    "calibration": {"$ref": "#/$defs/calibration"},
    "software": {"$ref": "#/$defs/software"},
    "errors": {
      "type": "array",
      "items": {"type": "string"}
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {"infer": {"$ref": "#/$defs/infer"}}
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["collection_type"],
        "properties": {"collection_type": {"const": "infer"}}
      },
      "then": {"properties": {"extensions": {"required": ["infer"]}}},
      "else": {"properties": {"extensions": {"not": {"required": ["infer"]}}}}
    },
    {
      "if": {
        "required": ["collection_type"],
        "properties": {"collection_type": {"const": "dagger"}}
      },
      "then": {"required": ["dagger"]},
      "else": {"not": {"required": ["dagger"]}}
    }
  ],
  "$defs": {
    "infer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "started_monotonic_ns",
        "ended_monotonic_ns",
        "actions_stopped_monotonic_ns",
        "recording_stop_requested_monotonic_ns",
        "label_monotonic_ns",
        "last_command_monotonic_ns",
        "label_source",
        "termination_reason",
        "command_count",
        "post_stop_recording_s",
        "recording_completed",
        "commit_protocol",
        "configuration"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "started_monotonic_ns": {
          "type": "integer",
          "minimum": 0
        },
        "ended_monotonic_ns": {
          "type": "integer",
          "minimum": 0
        },
        "actions_stopped_monotonic_ns": {
          "type": "integer",
          "minimum": 0
        },
        "recording_stop_requested_monotonic_ns": {
          "type": "integer",
          "minimum": 0
        },
        "label_monotonic_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "last_command_monotonic_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "label_source": {
          "enum": [
            "left_pedal",
            "right_pedal",
            "both_pedals",
            null
          ]
        },
        "termination_reason": {
          "enum": [
            "human_label",
            "label_conflict",
            "operator_abort",
            "runtime_fault"
          ]
        },
        "command_count": {
          "type": "integer",
          "minimum": 0
        },
        "post_stop_recording_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "recording_completed": {
          "const": true
        },
        "commit_protocol": {
          "const": "episode_store_atomic_rename"
        },
        "configuration": {
          "type": "object",
          "required": [
            "checkpoint_sha256",
            "policy_config_sha256",
            "action_order",
            "action_units",
            "command_topic",
            "checkpoint_profile",
            "rtc_rollout"
          ],
          "properties": {
            "checkpoint_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "policy_config_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "action_order": {
              "type": "array",
              "minItems": 14,
              "maxItems": 14,
              "items": {
                "type": "string"
              }
            },
            "action_units": {
              "type": "array",
              "minItems": 14,
              "maxItems": 14,
              "items": {
                "enum": [
                  "rad",
                  "vendor_raw"
                ]
              }
            },
            "command_topic": {
              "const": "/infer/command"
            }
          }
        }
      }
    },
    "dagger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_sha256", "intervention_count", "control_segments"],
      "properties": {
        "checkpoint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "intervention_count": {"type": "integer", "minimum": 0},
        "control_segments": {
          "type": "array",
          "items": {"$ref": "#/$defs/control_segment"}
        },
        "shadow": {"$ref": "#/$defs/shadow"}
      }
    },
    "shadow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality",
        "inference_attempt_count",
        "inference_success_count",
        "inference_failure_count",
        "recovery_count"
      ],
      "properties": {
        "quality": {"enum": ["healthy", "degraded", "invalid"]},
        "inference_attempt_count": {"type": "integer", "minimum": 0},
        "inference_success_count": {"type": "integer", "minimum": 0},
        "inference_failure_count": {"type": "integer", "minimum": 0},
        "recovery_count": {"type": "integer", "minimum": 0}
      }
    },
    "control_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "started_offset_s", "ended_offset_s"],
      "properties": {
        "owner": {"enum": ["model", "human"]},
        "started_offset_s": {"type": "number", "minimum": 0},
        "ended_offset_s": {"type": "number", "minimum": 0},
        "intervention_id": {"type": "integer", "minimum": 1}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at", "duration_s"],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "duration_s": {"type": "number", "minimum": 0}
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "config_schema_version", "devices"],
      "properties": {
        "id": {"type": ["string", "null"], "minLength": 1},
        "config_schema_version": {"type": "integer", "minimum": 1},
        "ros_domain_id": {"type": "integer", "minimum": 0, "maximum": 232},
        "devices": {
          "type": "array",
          "items": {"$ref": "#/$defs/device"}
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["config_schema_version"],
            "properties": {"config_schema_version": {"minimum": 3}}
          },
          "then": {"required": ["ros_domain_id"]}
        }
      ]
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "serial_number", "configuration"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "serial_number": {"type": ["string", "null"], "minLength": 1},
        "configuration": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topic",
        "required",
        "expected_hz",
        "message_count",
        "observed_hz",
        "max_gap_ms",
        "warnings"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "expected_hz": {"type": "number", "exclusiveMinimum": 0},
        "message_count": {"type": "integer", "minimum": 0},
        "observed_hz": {"type": "number", "minimum": 0},
        "max_gap_ms": {"type": "number", "minimum": 0},
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intrinsics", "extrinsics"],
      "properties": {
        "intrinsics": {"type": "null"},
        "extrinsics": {"type": "null"}
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
