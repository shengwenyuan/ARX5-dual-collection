# Copy to /var/lib/arx5-collection/dagger.env on each station.
# This file contains deployment identity and paths, not per-Episode state.
ARX5_DAGGER_COLLECTOR_IMAGE=arx5-dual-collection:dagger
ARX5_DAGGER_POLICY_IMAGE=arx5-dual-policy:dagger
ARX5_DAGGER_POLICY_CONFIG=/var/lib/arx5-collection/dagger-policy.toml
ARX5_CHECKPOINT_ROOT=/var/lib/arx5-collection/checkpoints
ARX5_TASK_CONFIG=/var/lib/arx5-collection/task.eight-stream.json
ARX5_REPORT_ROOT=/data/arx5-collection/reports
ARX5_DAGGER_MODE=takeover
