ARX5_COLLECTOR_IMAGE=arx5-dual-collection:production
ARX5_COLLECTION_CONFIG=/var/lib/arx5-collection/collection.toml
ARX5_OUTPUT_ROOT=/home/lenovo/swy/reports/YYYY-MM-DD/session-name
ARX5_REPORTS_ROOT=/home/lenovo/swy/reports
ARX5_STATION_DIR=/var/lib/arx5-collection
ARX5_CONFIG_ROOT_HOST=..
ARX5_SHM_SIZE=1gb
ARX5_STOP_GRACE_PERIOD=45s
